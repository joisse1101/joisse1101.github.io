{
  "name": "joisse1101.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:force": "vite --force",
    "dev:link": "yalc link @joisse1101/ui-library && npm run dev:force",
    "dev:update": "yalc update @joisse1101/ui-library && npm run dev:force",
    "build": "tsc -b && vite build",
    "build:unlink": "yalc retreat @joisse1101/ui-library && npm update @joisse1101/ui-library && npm install && npm run build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@joisse1101/ui-library": "^1.0.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "gray-matter": "^4.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sass-embedded": "^1.106.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1"
  }
}